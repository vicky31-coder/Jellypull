# ==============================================================================
# Jellypull - Single-User Self-Hosted Configuration
# ==============================================================================

# Master Password for your personal Jellypull instance.
# When set, locks the web interface and API until unlocked with this password.
# Leave empty to run in open LAN mode without password.
JELLYPULL_PASSWORD=your_secure_password_here

# Port to expose the Web UI and API on your server (default: 8045)
PORT=8045

# Enforce Safe Search by default (1 = enabled, 0 = disabled)
# Drops 18+ adult torrents, porn studios, and NSFW categories automatically
SAFE_SEARCH=1
